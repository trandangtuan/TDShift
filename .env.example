PORT=3100
WEBSITE_BASE_URL=http://localhost:3100

# Database
# sqlite is the default local development database.
DATABASE_CLIENT=sqlite
SQLITE_DATABASE_PATH=record-platform.sqlite
# SQLite catalog and directory used by the multi-database manager.
DATABASE_CATALOG_PATH=record-platform.sqlite.catalog.sqlite
# DATABASE_DIRECTORY=storage/databases
# Odoo-style database selection: %d is the first hostname label, %h is the full host.
# DB_FILTER=^%d$
# FILTER_DB=^%d$
# DB_NAME=main
SQL_LOG=false

# PostgreSQL option. Requires the psql CLI to be available to the server process.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://record_platform:record_platform@localhost:5432/record_platform
POSTGRES_DB=record_platform
POSTGRES_USER=record_platform
POSTGRES_PASSWORD=record_platform
APP_PORT=3100

# Docker multi-database mode (SQLite). Set DATABASE_CLIENT=sqlite when using it.
# DATABASE_CLIENT=sqlite
# SQLITE_DATABASE_PATH=/app/storage/databases/record-platform.sqlite
# DATABASE_CATALOG_PATH=/app/storage/databases/record-platform.sqlite.catalog.sqlite
# DATABASE_DIRECTORY=/app/storage/databases

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_SECONDS=28800
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.local

# MinIO attachment storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=record-platform

# Optional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
