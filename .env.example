PORT=3100
WEBSITE_BASE_URL=http://localhost:3100

# Database
# sqlite is the default local development database.
DATABASE_CLIENT=sqlite
SQLITE_DATABASE_PATH=record-platform.sqlite

# PostgreSQL option. Requires the psql CLI to be available to the server process.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://record_platform:record_platform@localhost:5432/record_platform
POSTGRES_DB=record_platform
POSTGRES_USER=record_platform
POSTGRES_PASSWORD=record_platform
APP_PORT=3100

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_SECONDS=28800
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.local

# Optional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
